/* ==========================================================================
   LIFECARE MULTISPECIALITY HOSPITAL — EXTERNAL STYLESHEET
   Technology: Pure CSS3 only (No JavaScript, no CSS frameworks)
   --------------------------------------------------------------------------
   SECTIONS:
   1. Color Variables & Reset
   2. Base Typography, Icons & Buttons
   3. Top Utility Bar & Sticky Navigation Bar
   4. Hero Section (Blue Transparent Overlay + Emergency Card)
   5. About Our Hospital (Photos, Mission & Vision)
   6. Medical Departments (8 Cards Grid)
   7. Doctor Profiles (4 Consistent Cards)
   8. Medical Services (8 Services on Deep Blue Band)
   9. Appointment Booking Section & Form
   10. Health Tips / Awareness Section
   11. Emergency Contact Section (Red Accent)
   12. Patient Testimonials
   13. Contact & Hospital Location (Pure-CSS Map)
   14. Footer
   15. Responsive Design (Desktop, Laptop, Tablet, Mobile)
   16. Accessibility: Reduced Motion
   ========================================================================== */


/* ==========================================================================
   1. COLOR VARIABLES & BASIC RESET
   ========================================================================== */

:root {
  /* Clinical Blue Palette */
  --blue-900: #062b4b;
  --blue-800: #083d6c;
  --blue-700: #0b5594;
  --blue-600: #116bb5;
  --blue-500: #1a84d6;
  --blue-100: #e2f0fb;
  --blue-50: #f2f8fd;

  /* Fresh Healing Light Green Palette */
  --green-700: #126d4d;
  --green-600: #198963;
  --green-500: #28a97c;
  --green-100: #daf5e9;
  --green-50: #f1fbf6;
  --mint: #b6f2d8;

  /* Authoritative Emergency Red Accent */
  --red-800: #781210;
  --red-700: #991a16;
  --red-600: #b8231e;

  /* Neutrals */
  --white: #ffffff;
  --ink: #0f2940;
  --ink-soft: #29465e;
  --muted: #526b80;
  --border: #dce8f2;
  --border-strong: #c6daea;
  --star: #e59a28;

  /* Typography */
  --font-heading: "Sora", "Segoe UI", Arial, sans-serif;
  --font-body: "Inter", "Segoe UI", Arial, sans-serif;

  /* Sizing, Radius & Shadows */
  --container-max: 1200px;
  --radius-lg: 18px;
  --radius-md: 12px;
  --radius-sm: 8px;
  --shadow-xs: 0 2px 10px rgba(6, 43, 75, 0.05);
  --shadow-sm: 0 10px 26px rgba(6, 43, 75, 0.07);
  --shadow-md: 0 18px 42px rgba(6, 43, 75, 0.12);
  --shadow-lg: 0 26px 60px rgba(6, 43, 75, 0.16);
  --ease: 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  color: var(--ink);
  background-color: var(--white);
  overflow-x: hidden; /* Guarantees zero horizontal scroll on any device */
  -webkit-font-smoothing: antialiased;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  list-style: none;
}

address {
  font-style: normal;
}

button,
input,
select,
textarea {
  font-family: inherit;
  font-size: inherit;
}

button,
summary {
  cursor: pointer;
}

::selection {
  background-color: var(--green-100);
  color: var(--blue-900);
}

:focus-visible {
  outline: 3px solid rgba(26, 132, 214, 0.5);
  outline-offset: 3px;
}


/* ==========================================================================
   2. BASE TYPOGRAPHY, ICONS, LABELS & BUTTONS
   ========================================================================== */

.container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 84px 0;
}

h1,
h2,
h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--blue-900);
}

h2 {
  font-size: clamp(1.85rem, 3.3vw, 2.65rem);
}

h2 em {
  font-style: normal;
  color: var(--green-700);
}

h3 {
  font-size: 1.12rem;
}

/* Visually hidden helper for screen readers */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* Hidden inline SVG sprite container */
.svg-sprite {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

/* Accessible keyboard skip link */
.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 1000;
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  background-color: var(--blue-700);
  color: var(--white);
  font-size: 0.85rem;
  font-weight: 600;
  transform: translateY(-160%);
  transition: transform var(--ease);
}

.skip-link:focus {
  transform: translateY(0);
}

/* Shared SVG icon styling */
.icon {
  width: 21px;
  height: 21px;
  flex-shrink: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.icon-xs {
  width: 15px;
  height: 15px;
}

.icon-sm {
  width: 18px;
  height: 18px;
}

/* Section eyebrow kicker */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--green-700);
}

.eyebrow::before {
  content: "";
  width: 26px;
  height: 2px;
  border-radius: 2px;
  background-color: currentColor;
}

.eyebrow-light {
  color: var(--mint);
}

.meta-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--green-700);
  margin-bottom: 4px;
}

/* Shared two-part section header */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 46px;
}

.section-head h2 {
  max-width: 580px;
}

.section-aside {
  max-width: 380px;
  padding-left: 22px;
  border-left: 2px solid var(--green-100);
}

.section-aside p {
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.7;
}

.section-aside .aside-note {
  margin-top: 8px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--green-700);
}

.section-aside .text-link {
  margin-top: 10px;
}

/* Link style */
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--blue-700);
  transition: color var(--ease), gap var(--ease);
}

.text-link:hover {
  color: var(--green-700);
  gap: 10px;
}

/* Subtle section disclaimer */
.fine-print {
  max-width: 740px;
  margin: 28px auto 0;
  text-align: center;
  font-size: 0.78rem;
  color: var(--muted);
}

/* Small demo indicator badges */
.demo-chip {
  display: inline-block;
  margin-left: 4px;
  padding: 1px 6px;
  border-radius: 4px;
  background-color: rgba(182, 242, 216, 0.18);
  color: var(--mint);
  font-style: normal;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.demo-badge-light {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 6px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 4px;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.88);
}

.demo-pill {
  margin-left: auto;
  padding: 4px 10px;
  border: 1px solid #b5e4cf;
  border-radius: 999px;
  background-color: var(--green-50);
  color: var(--green-700);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* Pulsing availability indicator */
.pulse-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #ff8e86;
  animation: pulseRing 2.2s infinite;
}

.pulse-dot-white {
  background-color: #ffe2df;
}

@keyframes pulseRing {
  0% { box-shadow: 0 0 0 0 rgba(255, 160, 152, 0.6); }
  70% { box-shadow: 0 0 0 7px rgba(255, 160, 152, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 160, 152, 0); }
}

/* Reusable Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 48px;
  padding: 12px 24px;
  border: 1.5px solid transparent;
  border-radius: var(--radius-sm);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  transition:
    background-color var(--ease),
    background var(--ease),
    border-color var(--ease),
    color var(--ease),
    box-shadow var(--ease),
    transform var(--ease);
}

.btn:hover {
  transform: translateY(-2px);
}

.btn .icon {
  width: 17px;
  height: 17px;
  transition: transform var(--ease);
}

.btn:hover .icon {
  transform: translateX(3px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--blue-600), var(--blue-700));
  border-color: var(--blue-700);
  color: var(--white);
  box-shadow: 0 8px 20px rgba(11, 85, 148, 0.22);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--blue-500), var(--blue-600));
  border-color: var(--blue-600);
  box-shadow: 0 12px 26px rgba(11, 85, 148, 0.3);
}

.btn-green {
  background: linear-gradient(135deg, var(--green-500), var(--green-600));
  border-color: var(--green-600);
  color: var(--white);
  box-shadow: 0 10px 24px rgba(18, 109, 77, 0.34);
}

.btn-green:hover {
  background: linear-gradient(135deg, #2fbc8b, var(--green-500));
  border-color: var(--green-500);
  box-shadow: 0 14px 30px rgba(18, 109, 77, 0.42);
}

.btn-outline {
  background-color: var(--white);
  border-color: var(--border-strong);
  color: var(--blue-800);
}

.btn-outline:hover {
  background-color: var(--blue-700);
  border-color: var(--blue-700);
  color: var(--white);
}

.btn-outline-light {
  background-color: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.65);
  color: var(--white);
}

.btn-outline-light:hover {
  background-color: var(--white);
  border-color: var(--white);
  color: var(--blue-900);
}

.btn-light {
  background-color: var(--white);
  border-color: var(--white);
  color: var(--blue-900);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
}

.btn-light:hover {
  background-color: var(--mint);
  border-color: var(--mint);
  color: var(--blue-900);
}

.btn-emergency-white {
  background-color: var(--white);
  border-color: var(--white);
  color: var(--red-800);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
}

.btn-emergency-white:hover {
  background-color: #fff2ef;
  border-color: #fff2ef;
}

.btn-emergency-ghost {
  background-color: transparent;
  border-color: rgba(255, 255, 255, 0.65);
  color: var(--white);
}

.btn-emergency-ghost:hover {
  background-color: rgba(255, 255, 255, 0.14);
  border-color: var(--white);
}

.btn-sm {
  min-height: 40px;
  padding: 9px 16px;
  font-size: 0.82rem;
}

.btn-full {
  width: 100%;
}

.stars {
  color: var(--star);
  font-size: 1rem;
  letter-spacing: 2px;
  line-height: 1;
}


/* ==========================================================================
   3. TOP UTILITY BAR & STICKY NAVIGATION BAR
   ========================================================================== */

.topbar {
  background-color: var(--blue-900);
  color: rgba(255, 255, 255, 0.82);
  font-size: 0.78rem;
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 40px;
  padding-top: 6px;
  padding-bottom: 6px;
}

.topbar-group {
  display: flex;
  align-items: center;
  gap: 20px;
}

.topbar-emergency,
.topbar-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.topbar-emergency {
  color: var(--white);
  transition: color var(--ease);
}

.topbar-emergency:hover {
  color: var(--mint);
}

.topbar-item .icon {
  color: var(--mint);
}

/* Sticky Navigation Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(255, 255, 255, 0.97);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(10px);
}

.header-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 80px;
}

/* Brand Logo */
.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  flex-shrink: 0;
}

.brand-mark {
  display: block;
  width: 44px;
  height: 44px;
  color: var(--blue-700);
  transition: color var(--ease), transform var(--ease);
}

.brand-mark svg {
  width: 100%;
  height: 100%;
}

.brand:hover .brand-mark {
  color: var(--green-600);
  transform: scale(1.04);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-heading);
  font-size: 1.32rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.05;
  color: var(--blue-900);
}

.brand-sub {
  margin-top: 2px;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--green-700);
}

/* Primary Nav Links */
.nav-list {
  display: flex;
  align-items: center;
  gap: 18px;
}

.nav-list a:not(.btn) {
  position: relative;
  display: inline-block;
  padding: 8px 0;
  font-size: 0.86rem;
  font-weight: 500;
  color: var(--ink-soft);
  white-space: nowrap;
  transition: color var(--ease);
}

.nav-list a:not(.btn)::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 2px;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background-color: var(--green-600);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform var(--ease);
}

.nav-list a:not(.btn):hover {
  color: var(--blue-700);
}

.nav-list a:not(.btn):hover::after {
  transform: scaleX(1);
}

.nav-cta {
  margin-left: 6px;
}

/* Mobile Toggle Controls (Hidden on Desktop) */
.nav-toggle {
  display: none;
}

.nav-toggle-label {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background-color: var(--blue-50);
  cursor: pointer;
}

.nav-toggle:focus-visible + .nav-toggle-label {
  outline: 3px solid rgba(26, 132, 214, 0.5);
  outline-offset: 2px;
}

.nav-bar {
  display: block;
  width: 20px;
  height: 2px;
  border-radius: 2px;
  background-color: var(--blue-800);
  transition: transform 0.25s ease, opacity 0.25s ease;
}


/* ==========================================================================
   4. HERO SECTION (Blue Transparent Overlay + Background Photo)
   ========================================================================== */

.hero {
  color: var(--white);
  background-color: var(--blue-900);
  background-image:
    linear-gradient(
      106deg,
      rgba(5, 34, 62, 0.94) 0%,
      rgba(8, 61, 108, 0.88) 48%,
      rgba(17, 107, 181, 0.64) 100%
    ),
    url("https://images.pexels.com/photos/6129499/pexels-photo-6129499.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200");
  background-size: cover;
  background-position: center 28%;
  background-repeat: no-repeat;
  padding-bottom: 42px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  align-items: center;
  gap: 44px;
  padding-top: 72px;
  padding-bottom: 46px;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(182, 242, 216, 0.35);
  background-color: rgba(255, 255, 255, 0.1);
  color: var(--mint);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pill-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--mint);
}

.hero h1 {
  margin-top: 18px;
  color: var(--white);
  font-size: clamp(2.55rem, 5vw, 4.15rem);
  font-weight: 700;
  line-height: 1.07;
  letter-spacing: -0.03em;
}

.hero h1 span {
  display: block;
  color: var(--mint);
}

.hero-tagline {
  margin-top: 16px;
  font-family: var(--font-heading);
  font-size: clamp(1.06rem, 1.6vw, 1.3rem);
  font-weight: 500;
  color: #e4f3ff;
}

.hero-desc {
  max-width: 560px;
  margin-top: 12px;
  font-size: 0.98rem;
  color: rgba(255, 255, 255, 0.84);
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.hero-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  margin-top: 28px;
}

.hero-highlights li {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.9);
}

.hero-highlights .icon {
  color: var(--mint);
}

/* Emergency Contact Card in Hero */
.hero-card {
  width: 100%;
  max-width: 370px;
  justify-self: end;
  padding: 26px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.24);
  background-color: rgba(6, 39, 70, 0.68);
  box-shadow: 0 22px 48px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(12px);
}

.hero-card-head {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hero-card-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 11px;
  background-color: rgba(184, 35, 30, 0.55);
  border: 1px solid rgba(255, 212, 206, 0.35);
  color: #ffe3df;
}

.hero-card-kicker {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
}

.hero-card-status {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--mint);
}

.hero-card-copy {
  margin-top: 16px;
  font-size: 0.94rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}

.hero-helpline {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  background-color: rgba(255, 255, 255, 0.1);
  transition: background-color var(--ease);
}

.hero-helpline:hover {
  background-color: rgba(255, 255, 255, 0.18);
}

.hero-helpline-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: var(--mint);
  color: var(--blue-900);
}

.hero-helpline small {
  display: block;
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
}

.hero-helpline strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.1;
  color: var(--white);
}

.hero-card-divider {
  height: 1px;
  background-color: rgba(255, 255, 255, 0.16);
  margin: 16px 0;
}

.hero-card-demo {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.82);
}

.hero-card-demo strong {
  color: var(--white);
  white-space: nowrap;
}

.hero-card-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--mint);
  transition: gap var(--ease), color var(--ease);
}

.hero-card-link:hover {
  gap: 10px;
  color: var(--white);
}

/* Bottom Hero Stats Strip */
.hero-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 20px 24px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.18);
  background-color: rgba(255, 255, 255, 0.09);

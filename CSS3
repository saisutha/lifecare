    padding: 22px 18px;
  }

  .appointment-card-head {
    flex-wrap: wrap;
  }

  .demo-pill {
    margin-left: 0;
  }

  .form-field-full {
    grid-column: auto;
  }

  .health-card:last-child,
  .testimonial-card:last-child {
    grid-column: auto;
    max-width: none;
  }

  .emergency-section {
    padding: 50px 0 38px;
  }

  .social-bar {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-disclaimer {
    text-align: left;
  }
}

/* --- Small Mobile Phones (320px–380px) --- */
@media (max-width: 380px) {
  .about-media {
    padding: 0;
  }

  .about-photo-inset {
    display: none;
  }

  .hero h1 {
    font-size: 2.15rem;
  }

  .rating-summary {
    flex-wrap: wrap;
  }

  .hours-list li {
    flex-direction: column;
    gap: 2px;
  }

  .hours-list li span:last-child {
    text-align: left;
  }
}


/* ==========================================================================
   16. ACCESSIBILITY: REDUCED MOTION
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

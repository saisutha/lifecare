/* ==========================================================================
   15. RESPONSIVE DESIGN (CSS3 MEDIA QUERIES)
   ========================================================================== */

/* --- Compact Desktop / Laptop (up to 1120px) --- */
@media (max-width: 1120px) {
  .topbar-location {
    display: none;
  }

  .nav-list {
    gap: 12px;
  }

  .nav-list a:not(.btn) {
    font-size: 0.8rem;
  }

  .nav-cta .btn-sm {
    padding: 8px 12px;
    font-size: 0.76rem;
  }

  .departments-grid,
  .doctors-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    gap: 36px;
  }
}

/* --- Tablet Screens (up to 960px) --- */
@media (max-width: 960px) {
  .section {
    padding: 68px 0;
  }

  /* Pure-CSS responsive hamburger dropdown menu */
  .nav-toggle {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .nav-toggle-label {
    display: flex;
    margin-left: auto;
  }

  .main-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--white);
    border-top: 1px solid transparent;
    box-shadow: none;
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: max-height 0.35s ease, visibility 0.35s ease;
  }

  .nav-toggle:checked ~ .main-nav {
    max-height: min(540px, calc(100vh - 80px));
    overflow-y: auto;
    visibility: visible;
    border-top-color: var(--border);
    box-shadow: 0 20px 42px rgba(6, 43, 75, 0.16);
  }

  .nav-toggle:checked + .nav-toggle-label .nav-bar:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle:checked + .nav-toggle-label .nav-bar:nth-child(3) {
    opacity: 0;
  }

  .nav-toggle:checked + .nav-toggle-label .nav-bar:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 8px 24px 20px;
  }

  .nav-list li {
    border-bottom: 1px solid var(--border);
  }

  .nav-list li:last-child {
    border-bottom: none;
  }

  .nav-list a:not(.btn) {
    display: block;
    padding: 13px 0;
    font-size: 0.94rem;
  }

  .nav-list a:not(.btn)::after {
    display: none;
  }

  .nav-cta {
    margin-left: 0;
    padding-top: 14px;
  }

  .nav-cta .btn {
    width: 100%;
    min-height: 46px;
    font-size: 0.88rem;
  }

  /* Multi-column layouts adjust smoothly for tablet */
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 28px;
    padding-top: 52px;
    padding-bottom: 34px;
  }

  .hero-card {
    justify-self: start;
    max-width: 480px;
  }

  .hero-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .hero-stats li {
    padding: 6px 14px;
  }

  .hero-stats li:nth-child(odd) {
    padding-left: 0;
    border-left: none;
  }

  .about-grid,
  .services-layout,
  .appointment-grid,
  .emergency-grid,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .about-media {
    max-width: 580px;
    margin: 0 auto;
    width: 100%;
  }

  .section-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .section-aside {
    padding-left: 0;
    padding-top: 12px;
    border-left: none;
    border-top: 2px solid var(--green-100);
    max-width: 560px;
  }

  .health-grid,
  .testimonials-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .health-card:last-child,
  .testimonial-card:last-child {
    grid-column: 1 / -1;
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
}

/* --- Mobile Phones (up to 640px) --- */
